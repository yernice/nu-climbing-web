# Copy to .env and fill in. .env is gitignored: never commit real passwords.

# Database: the climbing_app login and nu_climbing database (see README.md). Payload keeps its tables in the "payload" schema.
DATABASE_URL=postgres://climbing_app:YOUR_DB_PASSWORD@localhost:5432/nu_climbing
# Signs admin logins. Long random string, e.g. from: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=
# Where this backend runs (used to build image URLs and to accept admin logins).
SERVER_URL=http://localhost:3000
# Optional copy of registrations in Google Sheets (see README.md). Empty URL = off.
SHEETS_WEBHOOK_URL=
SHEETS_SECRET=
# Vercel only: set automatically when you connect a Blob store. Leave empty on your computer
# (images are then saved in back/media).
BLOB_READ_WRITE_TOKEN=
